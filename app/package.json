{
  "name": "nexo-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA móvil para hablar con el agente DSH de tu PC",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mock": "node mock/server.mjs",
    "smoke": "node mock/smoke.mjs",
    "shots": "node mock/ui-shots.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
